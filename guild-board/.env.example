# ---------------------------------------------------------------------------
# Guild Board — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Server-only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Stripe Connect --------------------------------------------------------
# Developers -> API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Developers -> Webhooks (or `stripe listen` for local dev)
STRIPE_WEBHOOK_SECRET=whsec_...
# Platform take rate applied to every escrowed task, in basis points (750 = 7.5%).
PLATFORM_FEE_BPS=750
# Where Stripe returns the worker after Express onboarding.
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/settings/payouts?refresh=1
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/settings/payouts?complete=1

# --- Mapbox ----------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoi...
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# --- Identity & background checks (stubs; see lib/verification/) ------------
PERSONA_API_KEY=persona_sandbox_...
PERSONA_TEMPLATE_ID=itmpl_...
PERSONA_WEBHOOK_SECRET=
CHECKR_API_KEY=test_...
CHECKR_PACKAGE_SLUG=tasker_pro
CHECKR_WEBHOOK_SECRET=

# --- Escrow policy ---------------------------------------------------------
# Hours a completed task waits, dispute-free, before funds auto-release.
ESCROW_AUTO_RELEASE_HOURS=72
# Shared secret the scheduled auto-release Edge Function presents to the API.
ESCROW_CRON_SECRET=generate-a-long-random-string
